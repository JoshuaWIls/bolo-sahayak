# Which AI answers the questions:
#   mock      — offline keyword demo, no key needed (default)
#   gemini    — FREE: get a key at https://aistudio.google.com/apikey  (best Hindi/Kannada + reads photos)
#   groq      — FREE: get a key at https://console.groq.com/keys
#   ollama    — FREE, runs on your own computer (install Ollama, then: ollama pull qwen2.5:7b)
#   anthropic — Claude API, paid (ANTHROPIC_API_KEY)
#   openai    — any other OpenAI-compatible API (set LLM_BASE_URL + LLM_API_KEY + LLM_MODEL)
LLM_PROVIDER=mock

GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Leave empty for each provider's default. `npm run models` lists the names your key can use.
LLM_MODEL=
# Optional: a different model for reading photos (groq needs a vision model; gemini/claude handle both).
LLM_VISION_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

PORT=4000
CORS_ORIGIN=http://localhost:5173
